+def stage(r, request_hash, attempt, work):
+    job = r['job']
+    need(job['attemptId'] == r['attemptId'] and digest(canonical(job)) == r['jobSha256'], 'job-binding')
+    need(0 < len(job['files']) <= 1024 and len(canonical(job)) <= 262144, 'job-budget')
