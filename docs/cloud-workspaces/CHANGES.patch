+    const plans:ArtifactPlan[]=[]; let total=0,count=0,entries=0;
+    // Preflight ALL files before cloud writes: no partial publish for known size/type errors.
+    let logChunks=0;
+    for(let i=0;i<files.length;i++) {
+      let plan:ArtifactPlan;
+      if(i<r.outputs.length&&isBundlePath(files[i].path)) {
+        const tar=await planBundle(root,files[i].path,r.profile.limits.maxOutputBytes-total,MAX_BUNDLE_ENTRIES-entries,signal);
+        plan={format:'tar',sizeBytes:tar.sizeBytes,tar}; entries+=tar.entries.length;
+      } else {
+        const stat=await inspectFile(root,files[i].path,signal); plan={format:'file',sizeBytes:stat.size,stat}; entries++;
+      }
+      check(entries<=MAX_BUNDLE_ENTRIES,'combined-tree-entry-budget-20000');
+      plans.push(plan); total+=plan.sizeBytes; count+=Math.ceil(plan.sizeBytes/CHUNK_BYTES);
+      check(total<=r.profile.limits.maxOutputBytes,'profile-output-byte-budget');
+      check(count<=PILOT_LIMITS.maxResultChunks,'output-and-log-chunk-budget-31');
+      if(i>=r.outputs.length) logChunks+=Math.ceil(plan.sizeBytes/CHUNK_BYTES);
+    }
+    check(total<=r.profile.limits.maxOutputBytes,'profile-output-byte-budget');
+    check(count<=PILOT_LIMITS.maxResultChunks,'output-and-log-chunk-budget-31');
+    check(logChunks<=64,'parent-log-claim-budget-64');
+    const grants=count+1, bytes=total+CHUNK_BYTES;
+    check(grants<=PILOT_LIMITS.maxNamespaceGrants&&bytes<=PILOT_LIMITS.maxNamespaceBytes,'pilot-namespace-request-limit');
+    // Authoritative admission still MUST refuse if existing grants, stored/read bytes
+    // or other reservations leave insufficient capacity. No namespace bypass/fallback.
+    const reservation=await reserve(scope,grants,bytes,ports,signal);
+    const lineage:OutputLineage[]=[], outputs:ResultManifest['outputs']=[], logs:ArtifactClaim[]=[];
+    for(let i=0;i<files.length;i++) {
+      const file=files[i], plan=plans[i], chunks:ArtifactClaim[]=[], digest=createHash('sha256');
+      let pending=new Uint8Array(CHUNK_BYTES),used=0,produced=0;
+      const flush=async()=>{
+        if(!used) return; const bytes=pending.subarray(0,used);
+        digest.update(bytes);
+        await ports.local.put(bytes,signal); await current(ports,reservation,signal);
+        chunks.push(await publish(bytes,'objects',scope,reservation,ports,signal));
+        pending=new Uint8Array(CHUNK_BYTES); used=0;
+      };
+      const append=async(bytes:Uint8Array)=>{
+        alive(signal); produced+=bytes.length; check(produced<=plan.sizeBytes,'artifact-size-grew');
+        for(let offset=0;offset<bytes.length;) {
+          const n=Math.min(CHUNK_BYTES-used,bytes.length-offset);
+          pending.set(bytes.subarray(offset,offset+n),used); used+=n; offset+=n;
+          if(used===CHUNK_BYTES) await flush();
