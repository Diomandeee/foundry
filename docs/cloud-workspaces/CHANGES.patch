+      `--user=${a.host.uid}:${a.host.gid}`,'--cap-drop=ALL','--security-opt=no-new-privileges=true','--cgroupns=private','--ipc=private',
+      '--cpus',String(plan.cpu),'--memory',`${plan.ramMib}m`,'--memory-swap',`${plan.ramMib}m`,'--pids-limit',String(a.limits.pids),
+      '--ulimit','core=0:0','--ulimit','nofile=1024:1024','--log-driver=none',
+      '--mount',`type=bind,src=${plan.inputRoot},dst=/input,readonly,bind-recursive=disabled`,
+      '--mount',`type=bind,src=${plan.workRoot},dst=/work,bind-recursive=disabled`,
+      '--tmpfs',`/tmp:rw,noexec,nosuid,nodev,size=${a.limits.tmpMib}m,mode=1777`,'--shm-size',`${a.limits.tmpMib}m`,
