+import { join } from 'node:path';
+import { readdir } from 'node:fs/promises';
+import { approvalFor, check, hash, phasesFor } from './plans.js';
+import { canonical, validateHost } from './host.js';
+import { command, launch, type ProcessHandle } from './process.js';
+import type { Running, RuntimeAdapter, RuntimePlan, StopProof } from './types.js';
+const controlEnv = Object.freeze({PATH:'/usr/bin:/bin',LANG:'C',LC_ALL:'C'});
+const unknown = (identity: string): StopProof => ({stopped:false,basis:'unknown',identity});
+
+/** An owner-supplied real containment inspector, NOT a callback that assumes kill succeeded.
+ * It must cover launchd/XPC/daemonized descendants and PID reuse, using host evidence.
+ * Without it native execution ALWAYS retains quarantine, including a zero exit. */
+export interface NativeDescendantAttestor {
+  inspect(input: {attemptId:string; uid:number; pid:number; leaderClosed:boolean; processTable:string}): Promise<StopProof>;
+}
+export class NativeMacAdapter implements RuntimeAdapter {
+  private readonly prepared = new WeakSet<object>();
+  constructor(private readonly attestor?: NativeDescendantAttestor) {}
+  async prepare(plan: RuntimePlan): Promise<void> {
+    const a = approvalFor(plan), r = a.recipe;
+    check(process.platform === 'darwin' && r.kind === 'xcode-build-v1' && r.trustedNativeProject, 'native-mac-only');
+    await validateHost(plan);
+    await canonical(r.developerDir,a.host.uid);
+    await canonical(plan.argv[0]!,a.host.uid,'file');
+    const version = await command(plan.argv[0]!,['-version'],plan.workRoot,{...controlEnv,DEVELOPER_DIR:r.developerDir});
+    check(version.split(/\r?\n/).includes(`Build version ${r.xcodeBuild}`),'xcode-build-mismatch');
+    const sdks = await command(plan.argv[0]!,['-showsdks'],plan.workRoot,{...controlEnv,DEVELOPER_DIR:r.developerDir});
+    check(sdks.split(/\r?\n/).some(line => line.trim().split(/\s+/).some((word,index,words) => word === '-sdk' && words[index+1] === r.sdk)), 'explicit-sdk-not-installed');
+    check((await command('/usr/bin/sw_vers',['-productVersion'],plan.workRoot,controlEnv)).trim() === r.macos,'macos-version-mismatch');
+    await canonical(join(plan.inputRoot,r.project),a.host.uid);
+    // Provisioned per-attempt state; no shared home, package cache, or DerivedData.
+    for (const name of ['home','tmp','DerivedData','dependencies','modules','swift-modules']) await canonical(join(plan.workRoot,name),a.host.uid,'directory',true);
+    this.prepared.add(plan);
+  }
+  async start(plan: RuntimePlan, recordIdentity: (id:string) => Promise<void>, beforeStart: () => void): Promise<Running> {
+    const a = approvalFor(plan);
+    check(this.prepared.delete(plan) && plan.kind === 'xcode-build-v1', 'native-not-prepared');
+    await validateHost(plan);
+    const identity = `native:${hash(plan.attemptId)}`;
+    await recordIdentity(identity); // Marker exists even if spawn/identity persistence is interrupted.
+    beforeStart();
+    const p = launch(plan.argv[0]!,plan.argv.slice(1),plan.inputRoot,plan.env,a.limits.maxOutputBytes,plan.timeoutMs);
+    try { await recordIdentity(`${identity}:pid:${p.pid ?? 'unknown'}`); }
+    catch (e) { p.killGroup(); throw e; }
+    const inspectStopped = async (): Promise<StopProof> => {
+      try {
+        // Read actual process state; an empty group/closed leader alone is insufficient.
+        const table = await command('/bin/ps',['-axo','uid=,pid=,ppid=,pgid='],plan.workRoot,controlEnv);
+        if (!p.pid || !p.closed() || !this.attestor) return unknown(identity);
+        const proof = await this.attestor.inspect({attemptId:plan.attemptId,uid:a.host.uid,pid:p.pid,leaderClosed:p.closed(),processTable:table});
+        return proof.stopped && proof.basis === 'host-containment-inspect' && proof.identity === identity ? proof : unknown(identity);
+      } catch { return unknown(identity); }
+    };
+    return {identity,completion:p.completion,inspectStopped,stop:async () => { p.killGroup(); await settleBriefly(p); return inspectStopped(); }};
+  }
+}
+async function settleBriefly(p: ProcessHandle): Promise<void> {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  try { await Promise.race([p.completion,new Promise<void>(resolve => { timer = setTimeout(resolve,1000); })]); }
+  finally { if (timer) clearTimeout(timer); }
+}
+export interface DockerHostConfig {
+  executable: string; socketPath: string; privateConfigPath: string;
+  /** Owner provisioned LOCAL Docker socket; no remote contexts, SSH, TLS or plugins. */
+}
+interface ContainerState { Id:string; Config:{Labels:Record<string,string>}; State:{Running:boolean;Status:string;ExitCode:number} }
+export class LinuxContainerAdapter implements RuntimeAdapter {
+  private readonly prepared = new WeakSet<object>();
+  private readonly config: Readonly<DockerHostConfig>;
+  constructor(config: DockerHostConfig) { this.config = Object.freeze({...config}); }
+  private async cli(plan:RuntimePlan, args: readonly string[]): Promise<string> {
+    const a = approvalFor(plan), c = this.config;
+    await canonical(c.executable,a.host.uid,'file'); await canonical(c.socketPath,a.host.uid,'socket');
+    await canonical(c.privateConfigPath,a.host.uid,'directory',true);
+    check((await readdir(c.privateConfigPath)).length === 0,'docker-config-must-be-empty');
+    return command(c.executable,['--config',c.privateConfigPath,'--host',`unix://${c.socketPath}`,...args],plan.workRoot,controlEnv);
+  }
+  async prepare(plan:RuntimePlan): Promise<void> {
+    const a = approvalFor(plan), r = a.recipe;
+    check(process.platform === 'linux' && r.kind === 'linux-build-v1','linux-host-only');
+    check(process.arch === r.architecture,'host-arch-mismatch');
+    await validateHost(plan);
