+      else await readFileChunks(root,file.path,plan.stat,CHUNK_BYTES,async bytes=>append(bytes),signal);
+      check(produced===plan.sizeBytes,'artifact-size-mismatch'); await flush();
+      check(chunks.length===Math.ceil(plan.sizeBytes/CHUNK_BYTES),'artifact-chunk-count');
+      const entry:OutputLineage={path:file.path,format:plan.format,classification:file.classification,retention:'retain',sha256:digest.digest('hex'),sizeBytes:plan.sizeBytes,chunks};
+      // A real empty file still passes inode/EOF checks. The chunk callback never
+      // runs, so it retains SHA-256(empty)/[] without any zero-byte publication.
+      lineage.push(entry);
+      if(i<r.outputs.length) outputs.push({path:entry.path,format:entry.format,sha256:entry.sha256,sizeBytes:entry.sizeBytes,chunks});
+      else logs.push(...chunks);
+    }
+    const profileHash=v.hash(r.profile);
+    const lineageLocal=await ports.local.put(jsonBytes({version:1,projectId:scope.projectId,compute:scope.compute,profileHash,files:lineage}),signal);
+    await current(ports,reservation,signal);
+    const collected=freeze({outputs,logs,lineage,totalBytes:total,chunkCount:count,reservation,scope,profileHash,lineageLocal});
+    collections.set(collected,{ports,budget:r.profile.limits.maxOutputBytes,manifestStarted:false}); return collected;
+  },signal);
+}
+
+/** Creates a bounded local staging object BEFORE the remote manifest write. Returns a
+ * stage-command artifact claim, not authority acceptance, verification or deployment. */
+export async function writeResultManifest(request:WriteResultRequest,ports:PackagingPorts,signal:AbortSignal):Promise<StagedResult> {
+  const c=request.collected, known=collections.get(c);
+  check(known&&known.ports===ports,'untrusted-or-foreign-collection');
+  const r=snapshot({jobId:request.jobId,attemptId:request.attemptId,inputHash:request.inputHash,profileHash:request.profileHash,exitCode:request.exitCode}) as Omit<WriteResultRequest,'collected'>;
+  check(r.profileHash===c.profileHash&&r.jobId===c.scope.compute.workloadId&&r.attemptId===c.scope.compute.attemptId,'result-lineage');
+  const manifest:ResultManifest={version:1,...r,outputs:c.outputs,logs:c.logs}; v.result(manifest);
+  check(c.totalBytes<=known.budget&&c.totalBytes<=PILOT_LIMITS.maxOutputBytes&&
+    c.chunkCount<=PILOT_LIMITS.maxResultChunks&&c.outputs.length<=PILOT_LIMITS.maxRequiredOutputs,'result-budget');
+  const bytes=jsonBytes(manifest); alive(signal);
+  check(!known.manifestStarted,'manifest-publication-already-attempted-reconcile-retained-evidence');
+  known.manifestStarted=true; // Reserve synchronously; parallel/repeated staging cannot overspend admission.
+  const local=await ports.local.put(bytes,signal);
+  const artifact=await publish(bytes,'manifests',c.scope,c.reservation,ports,signal);
+  check(artifact.ref.sha256===sha256(bytes)&&canonical(manifest)===Buffer.from(bytes).toString('utf8'),'manifest-byte-binding');
+  const receiptLocal=await ports.local.put(jsonBytes({version:1,kind:'build-result-lineage',jobId:r.jobId,attemptId:r.attemptId,
+    inputHash:r.inputHash,profileHash:r.profileHash,compute:c.scope.compute,manifest:artifact,manifestLocal:local,
+    fileLineageLocal:c.lineageLocal,reservation:c.reservation,retention:'retain'}),signal);
+  await current(ports,c.reservation,signal);
+  return freeze({manifest,artifact,local,lineageLocal:c.lineageLocal,receiptLocal});
+}
