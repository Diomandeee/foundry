new file mode 100644
--- /dev/null
+++ b/packages/build-runtime/src/storage-inventory.ts
@@ -0,0 +1,71 @@
+import { lstat, opendir } from 'node:fs/promises';
+import { join } from 'node:path';
+import { performance } from 'node:perf_hooks';
+import { canonical } from './host.js';
+import { absolute, check } from './plans.js';
+export interface StorageRoot {role:'cache'|'workspace';path:string;uid:number}
+export interface StorageScanLimits {maxEntries:number;maxDepth:number;maxDurationMs:number}
+export interface StorageMeasurement {
+  role:'cache'|'workspace';root:string;complete:boolean;
+  observedEntries:number;observedApparentBytes:number;observedAllocatedBytes:number;
+  reason:'complete'|'limit'|'unsafe-or-unavailable'|'changed-during-scan';
+}
+export interface ManagedStorageInventory {
+  observedAt:number;source:'node-lstat';complete:boolean;
+  /** Census budget uses apparent bytes; neither measure is APFS reclaimable space. */
+  cacheBytes:number|null;workspaceBytes:number|null;roots:StorageMeasurement[];
+}
+/** Read-only, bounded metadata scan. Never opens file contents, follows symlinks,
+ * traverses nested mounts, deletes, evicts, or treats APFS blocks as reclaimable. */
+export async function managedStorageInventory(approved:readonly StorageRoot[],limits:StorageScanLimits={maxEntries:10000,maxDepth:32,maxDurationMs:2000}):Promise<ManagedStorageInventory> {
+  const roots = approved.map(root => ({...root})), budget = {...limits};
+  check(roots.length > 0 && roots.length <= 16,'inventory-root-count');
+  for (const root of roots) {absolute(root.path);check(root.role === 'cache' || root.role === 'workspace','inventory-role');}
+  for (let i=0;i<roots.length;i++) for (let j=i+1;j<roots.length;j++) check(roots[i]!.path !== roots[j]!.path && !roots[i]!.path.startsWith(`${roots[j]!.path}/`) && !roots[j]!.path.startsWith(`${roots[i]!.path}/`),'inventory-overlapping-roots');
+  check(Number.isSafeInteger(budget.maxEntries) && budget.maxEntries > 0 && budget.maxEntries <= 100000 && Number.isSafeInteger(budget.maxDepth) && budget.maxDepth > 0 && budget.maxDepth <= 64 && Number.isSafeInteger(budget.maxDurationMs) && budget.maxDurationMs > 0 && budget.maxDurationMs <= 30000,'inventory-limits');
+  const began = performance.now(); let entries = 0;
+  const result:StorageMeasurement[] = [];
+  for (const root of roots) {
+    const row:StorageMeasurement = {role:root.role,root:root.path,complete:false,observedEntries:0,observedApparentBytes:0,observedAllocatedBytes:0,reason:'unsafe-or-unavailable'};
+    let failed:StorageMeasurement['reason']|undefined;
+    const available = () => {
+      if (entries >= budget.maxEntries || performance.now()-began >= budget.maxDurationMs) {failed = 'limit';return false;}
+      return true;
+    };
+    try {
+      await canonical(root.path,root.uid,'directory',true);
+      const anchor = await lstat(root.path);
+      const walk = async (path:string,depth:number):Promise<void> => {
+        if (failed || !available()) return;
+        if (depth > budget.maxDepth) {failed = 'limit';return;}
+        const before = await lstat(path);
+        check(before.uid === root.uid && (before.mode & 0o022) === 0 && !before.isSymbolicLink() && before.dev === anchor.dev && (before.isDirectory() || (before.isFile() && before.nlink === 1)),'unsafe-inventory-entry');
+        entries++;row.observedEntries++;
+        // Apparent FILE data excludes directory metadata; allocated includes directory blocks.
+        row.observedApparentBytes += before.isFile() ? before.size : 0;
+        row.observedAllocatedBytes += before.blocks*512;
+        check(Number.isSafeInteger(row.observedApparentBytes) && Number.isSafeInteger(row.observedAllocatedBytes),'inventory-byte-overflow');
+        if (before.isDirectory()) {
+          const directory = await opendir(path);
+          try {
+            for await (const entry of directory) {
+              if (!available() || failed) break;
+              await walk(join(path,entry.name),depth+1);
+            }
+          } finally {await directory.close().catch(() => {});}
+        }
+        const after = await lstat(path);
+        if (before.dev !== after.dev || before.ino !== after.ino || before.size !== after.size || before.mtimeMs !== after.mtimeMs || before.ctimeMs !== after.ctimeMs) failed = 'changed-during-scan';
+      };
+      await walk(root.path,0); if (performance.now()-began >= budget.maxDurationMs) failed = 'limit';
+      row.complete = !failed; row.reason = failed ?? 'complete';
+    } catch {row.reason = failed ?? 'unsafe-or-unavailable';}
+    result.push(row);
+  }
+  const total = (role:StorageRoot['role']):number|null => {
+    const selected = result.filter(row => row.role === role);
+    return selected.length && selected.every(row => row.complete) ? selected.reduce((n,row) => n+row.observedApparentBytes,0) : null;
+  };
+  const cacheBytes = total('cache'), workspaceBytes = total('workspace');
+  return {observedAt:Date.now(),source:'node-lstat',complete:result.every(row => row.complete) && cacheBytes !== null && workspaceBytes !== null,cacheBytes,workspaceBytes,roots:result};
+}
diff --git a/packages/build-runtime/src/supervisor.ts b/packages/build-runtime/src/supervisor.ts
new file mode 100644
--- /dev/null
+++ b/packages/build-runtime/src/supervisor.ts
@@ -0,0 +1,105 @@
+import { performance } from 'node:perf_hooks';
+import { approvalFor, check } from './plans.js';
+import { HostJournal } from './host.js';
+import type { Exit, LeasePort, Running, RuntimeAdapter, RuntimePlan, StopProof, SupervisorResult } from './types.js';
+
+const unknown = (identity:string): StopProof => ({stopped:false,basis:'unknown',identity});
+async function deadline<T>(work: Promise<T>, ms:number, expired:() => void): Promise<T> {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  try { return await Promise.race([work,new Promise<never>((_,reject) => {
+    timer = setTimeout(() => { expired(); reject(new Error('deadline')); },ms);
+  })]); } finally { if (timer) clearTimeout(timer); }
+}
+/** No authority/authentication implementation here. DI renewals are fenced by parent.
+ * A successful request grants at most 60s from REQUEST START, never response arrival. */
+export class LongJobSupervisor {
+  constructor(private readonly journal:HostJournal, private readonly lease:LeasePort, private readonly adapter:RuntimeAdapter) {}
+  async run(plan:RuntimePlan, cancel?:AbortSignal, hooks?: {
+    /** Monotonic deadline anchored before claim, includes transfer/report time. */
+    deadlineAt?:number;
+    prepare?:(scope:{signal:AbortSignal;assertLease:()=>void})=>Promise<void>;
+    afterStop?:(result:SupervisorResult,scope:{signal:AbortSignal;assertLease:()=>void})=>Promise<void>;
+  }): Promise<SupervisorResult> {
+    approvalFor(plan);
+    check(!cancel?.aborted,'cancelled-before-reservation');
+    const reservation = await this.journal.reserve(plan); // fsynced BEFORE any run-capable port
+    let running: Running | undefined, exit: Exit | undefined;
+    let expiry = 0, reason: 'cancelled'|'lease-lost'|'timeout'|undefined;
+    let renewing = false, done = false;
+    const pendingRenewals = new Set<AbortController>();
+    const operation = new AbortController();
+    const halt = (why:typeof reason) => { if (!done && !reason) { reason = why; operation.abort(); } };
+    const onCancel = () => halt('cancelled');
+    cancel?.addEventListener('abort',onCancel,{once:true});
+    const renewal = async () => {
+      if (done || reason || renewing) return;
+      renewing = true;
+      const abort = new AbortController(); pendingRenewals.add(abort);
+      const sent = performance.now();
+      try {
+        const grant = await deadline(this.lease.renew(plan,60000,abort.signal),10000,() => abort.abort());
+        if (done || reason) return;
+        if (!grant.valid || grant.cancel) { halt(grant.cancel ? 'cancelled' : 'lease-lost'); return; }
+        expiry = sent + 60000;
+      } catch { halt('lease-lost'); }
+      finally { renewing = false; pendingRenewals.delete(abort); }
+    };
+    let interval: ReturnType<typeof setInterval> | undefined;
+    let watchdog: ReturnType<typeof setInterval> | undefined;
+    const deadlineAt = Math.min(performance.now()+plan.timeoutMs,hooks?.deadlineAt ?? Infinity);
+    let stopSignalResolve!: () => void;
+    const stopSignal = new Promise<void>(resolve => { stopSignalResolve = resolve; });
+    const fence = () => {
+      if (cancel?.aborted) halt('cancelled');
+      if (performance.now() >= deadlineAt) halt('timeout');
+      if (performance.now() >= expiry) halt('lease-lost');
+      check(!done && !reason,'activation-fence-closed');
+    };
+    let proof = unknown(plan.attemptId);
+    let outcome: SupervisorResult['outcome'] = 'quarantined';
+    try {
+      await renewal(); fence();
+      interval = setInterval(() => { void renewal(); },15000);
+      watchdog = setInterval(() => {
+        if (cancel?.aborted) halt('cancelled');
+        if (performance.now() >= deadlineAt) halt('timeout');
+        if (performance.now() >= expiry) halt('lease-lost');
+        if (reason) stopSignalResolve();
+      },100);
+      if (hooks?.prepare) await deadline(hooks.prepare({signal:operation.signal,assertLease:fence}),Math.max(1,deadlineAt-performance.now()),() => halt('timeout'));
+      fence();
+      await this.adapter.prepare(plan); fence();
+      running = await this.adapter.start(plan,id => reservation.recordIdentity(id),fence);
+      // Stop immediately even when cancellation happened during async identity persistence.
+      if (reason || cancel?.aborted) stopSignalResolve();
+      const result = await Promise.race([running.completion.then(value => ({exit:value})),stopSignal.then(() => ({exit:undefined}))]);
+      exit = result.exit;
+      if (reason || !exit || exit.limited) {
+        if (!reason && exit?.limited) halt('timeout');
+        proof = await deadline(running.stop(),10000,() => {});
+      } else {
+        proof = await deadline(running.inspectStopped(),10000,() => {});
+        if (!proof.stopped) proof = await deadline(running.stop(),10000,() => {});
+      }
+      if (proof.stopped) outcome = reason ?? (exit?.code === 0 && !exit.limited ? 'completed' : 'failed');
+      if (reason === 'lease-lost') outcome = 'quarantined';
+      if (hooks?.afterStop) await deadline(hooks.afterStop({outcome,stop:proof,...(exit && outcome === 'completed' ? {exit} : {})},{signal:operation.signal,assertLease:fence}),Math.max(10000,deadlineAt-performance.now()),() => halt('timeout'));
+    } catch {
+      if (running) {
+        try { proof = await deadline(running.stop(),10000,() => {}); } catch { proof = unknown(running.identity); }
+      }
+      outcome = 'quarantined';
+    } finally {
+      done = true;
+      operation.abort();
+      if (interval) clearInterval(interval); if (watchdog) clearInterval(watchdog);
+      for (const a of pendingRenewals) a.abort();
+      cancel?.removeEventListener('abort',onCancel);
+    }
+    // Never release on ambiguous activation/control/renewal even with partial stop evidence.
+    if (!proof.stopped || reason === 'lease-lost' || (reason && outcome === 'completed')) outcome = 'quarantined';
+    try { await reservation.finish(proof,outcome); }
+    catch { return {outcome:'quarantined',stop:unknown(running?.identity ?? plan.attemptId)}; }
+    return {outcome,stop:proof,...(exit && outcome === 'completed' ? {exit} : {})};
+  }
+}
