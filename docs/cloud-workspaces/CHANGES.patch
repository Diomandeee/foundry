+ `CREATE TABLE IF NOT EXISTS build_worker_approvals(worker TEXT NOT NULL,revision INTEGER NOT NULL,profile TEXT NOT NULL REFERENCES build_profiles(hash),preference INTEGER NOT NULL CHECK(preference BETWEEN 0 AND 100),PRIMARY KEY(worker,revision,profile))`,
