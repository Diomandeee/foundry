+  claims.forEach((claim,index) => {
+    const object = receipt.objects[index]!;
+    check(canonicalData(claim) === canonicalData(object.claim) && /^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/.test(claim.grantId),'published-claim-mismatch');
