+            try require(fd >= 0, "artifact-open")
+            do {
+                let s = try statFD(fd)
+                try require(isType(s, mode_t(S_IFREG)) && s.st_nlink == 1 && s.st_uid == (writable ? c.uid : 0) && (s.st_mode & 0o7777) == (writable ? 0o600 : 0o444) && s.st_size > 0 && UInt64(s.st_size) <= limit, "artifact-policy")
