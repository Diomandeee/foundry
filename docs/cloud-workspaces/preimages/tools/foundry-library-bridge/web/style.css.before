:root{font:16px/1.55 system-ui,sans-serif;color:#e4e9ef;background:#10151c;color-scheme:dark}*{box-sizing:border-box}body{margin:0}header{padding:22px 5vw;border-bottom:1px solid #303947;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.brand{font-size:13px;letter-spacing:.15em;color:#9bb6cd}main{max-width:1120px;margin:45px auto;padding:0 24px 80px}h1{font-size:clamp(30px,5vw,48px);letter-spacing:-.035em;line-height:1.15}h2{font-size:30px}p,small{color:#b3c0ce}aside{background:#1b2735;border-left:3px solid #9bb6cd;padding:14px 18px;margin:20px 0}label{display:block;margin-top:22px}input[type=search]{width:100%;padding:15px;border:1px solid #48586b;border-radius:8px;font:inherit;background:#17202b}.filters{display:flex;align-items:center;justify-content:space-between;margin:16px 0;gap:15px}.filters label{margin:0}#projects{display:grid;grid-template-columns:repeat(auto-fill,minmax(245px,1fr));gap:12px}button{cursor:pointer;font:inherit;border:1px solid #3b4d60;border-radius:8px;background:#182330;color:inherit;padding:16px;text-align:left}button:hover{border-color:#a4d2e3}button:focus-visible,input:focus-visible{outline:3px solid #a4d2e3;outline-offset:3px}button:disabled{opacity:.5;cursor:not-allowed}.project{display:flex;flex-direction:column;gap:8px;overflow-wrap:anywhere}.project span,.project small{font-size:13px}.project strong{font-size:18px}#detail{margin-top:50px;border-top:1px solid #48586b;padding-top:20px}.version{border:1px solid #3b4d60;border-radius:8px;padding:20px;margin:16px 0;overflow-wrap:anywhere}.version h3{margin:0}.pull{display:block;margin-top:16px;background:#294c60}details{margin-top:20px}summary{cursor:pointer}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.6 ui-monospace,monospace;max-height:340px;overflow:auto}.good{color:#a6dbbc}#status{position:sticky;bottom:10px;background:#26394a;border-radius:8px;margin-top:25px;padding:16px;overflow-wrap:anywhere}#status:empty{display:none}@media(max-width:600px){main{margin-top:25px;padding:0 16px 50px}.filters{align-items:flex-start;flex-direction:column}.version{padding:14px}}
