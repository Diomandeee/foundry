'use strict';
(() => {
 const $=id=>document.getElementById(id);let view=null,preview=null,pending=null,busy=false,generation=0,ready=false,placementRevision=0;const downloads=new Set();
 const set=(id,text)=>{$(id).textContent=text;};
 async function api(path,body){const epoch=generation;const r=await fetch('/api/builds/'+path,{method:body?'POST':'GET',credentials:'same-origin',headers:body?{'content-type':'application/json'}:{},body:body?JSON.stringify(body):undefined,signal:AbortSignal.timeout(12000)});const value=await r.json();if(epoch!==generation)throw Error('operator-session-changed');if(!r.ok)throw Error(value.code||'build-source-unavailable');return value;}
 function option(select,value,label){const o=document.createElement('option');o.value=value;o.textContent=label;select.append(o);}
 function resetPreview(){placementRevision++;preview=null;$('build-submit').disabled=true;set('build-placement','Review placement for this exact project, input and recipe.');}
 function fill(savedInput=$('build-input').value,savedProfile=$('build-profile').value){const project=$('build-project').value;$('build-input').replaceChildren();$('build-profile').replaceChildren();for(const i of view.inputs.filter(i=>i.project===project))option($('build-input'),i.hash,`${i.hash.slice(0,12)} · ${i.body.reconstructable?'approved reconstructable':'missing/unproven inputs'}`);for(const p of view.profiles.filter(p=>p.project===project))option($('build-profile'),p.hash,`${p.body.kind} · ${p.hash.slice(0,12)}`);if([...$('build-input').options].some(o=>o.value===savedInput))$('build-input').value=savedInput;if([...$('build-profile').options].some(o=>o.value===savedProfile))$('build-profile').value=savedProfile;$('build-preview').disabled=!$('build-input').value||!$('build-profile').value;resetPreview();}
 function list(id,items,render){const root=$(id);root.replaceChildren();if(!items.length){root.textContent='No records in this bounded authority window.';return;}for(const item of items){const p=document.createElement('p');p.textContent=render(item);root.append(p);}}
 function clearProtected(){$('build-repeat').checked=false;generation++;placementRevision++;for(const a of downloads)a.abort();downloads.clear();view=null;preview=null;pending=null;for(const id of ['build-project','build-input','build-profile','build-placement','build-workers','build-jobs','build-attempts','build-events','build-result','build-capacity','build-window-status'])$(id).replaceChildren();$('build-preview').disabled=true;$('build-submit').disabled=true;set('build-status','Operator access unavailable. Protected build data cleared; durable submission intent remains on the host.');}
 window.addEventListener('foundry-operator-session',e=>{ready=e.detail?.state==='ready';if(!ready)clearProtected();else void refresh();});
 setInterval(()=>{if(ready&&!busy)void refresh();},15000);
 async function refresh(){if(busy)return;busy=true;try{view=await api('view');set('build-status',`Authority observed ${new Date(view.observedAt).toLocaleString()}. ${view.actionsEnabled?'Build actions explicitly enabled.':'Build actions gated.'} Candidate validation remains pending.`);set('build-window-status',Object.entries(view.windows||{}).map(([name,w])=>`${name}: ${w.returned}/${w.total}${w.truncated?' (truncated)':''}`).join(' · '));const chosen=$('build-project').value;$('build-project').replaceChildren();for(const p of [...new Set(view.profiles.map(p=>p.project))])option($('build-project'),p,p);if([...$('build-project').options].some(o=>o.value===chosen))$('build-project').value=chosen;fill();list('build-workers',view.workers,w=>`${w.worker}: ${w.body.os} ${w.body.architecture}; Xcode build IDs ${w.body.xcodeBuilds.join(', ')||'none'}; census received ${new Date(w.observed_ms).toLocaleString()}; active jobs ${w.body.activeJobs}`);list('build-capacity',view.workers,w=>`${w.worker}: ${(w.body.freeBytes/1024**3).toFixed(1)} GiB reported free; managed cache ${w.body.storage?.cacheBytes===null||w.body.storage?.cacheBytes===undefined?'unknown':(w.body.storage.cacheBytes/1024**3).toFixed(1)+' GiB'}; workspaces ${w.body.storage?.workspaceBytes===null||w.body.storage?.workspaceBytes===undefined?'unknown':(w.body.storage.workspaceBytes/1024**3).toFixed(1)+' GiB'}; inventory ${w.body.storage?.complete?'complete':'incomplete'}. Cleanup not approved.`);
 list('build-events',view.events,e=>{const body=JSON.parse(e.body);return `${e.seq} · ${e.kind} · ${e.entity} · ${new Date(e.at_ms).toLocaleString()}${body.placement?' · '+JSON.stringify(body.placement):''}`;});list('build-attempts',view.attempts,a=>`${a.jobId} / ${a.id}: ${a.effectiveState} (recorded ${a.state}); worker ${a.workerId}; epoch ${a.epoch}, generation ${a.generation}, incarnation ${a.incarnation}; lease expiry ${new Date(a.expiresAt).toLocaleString()}; stop ${a.stopped?'confirmed':'unconfirmed'}, host slot ${a.slotHeld?'retained':'released'}`);const root=$('build-jobs');root.replaceChildren();for(const j of view.jobs){const p=document.createElement('p');p.textContent=`${j.id} · ${j.effectiveState||j.state} (recorded ${j.state}) · generation ${j.generation} · attempts ${j.attempts} `;if(j.state==='SUCCEEDED'){const b=document.createElement('button');b.textContent='Read verified artifact receipt';b.onclick=async()=>{try{const r=await api('result',{jobId:j.id});showResult(r);}catch(e){set('build-result',e.message);}};p.append(b);}if(view.actionsEnabled&&!['EXPIRED','FENCED'].includes(j.effectiveState)&&['QUEUED','RUNNING','VERIFYING'].includes(j.state)){const b=document.createElement('button');b.textContent='Cancel build';let requestId=null;b.onclick=async()=>{requestId??=crypto.randomUUID();try{await api('cancel',{jobId:j.id,requestId});await refresh();}catch(e){set('build-status',`Cancellation uncertain: ${e.message}; retry preserves its request ID.`);}};p.append(b);}root.append(p);}if(!view.jobs.length)root.textContent='No build jobs in this window.';
 }catch(e){clearProtected();resetPreview();$('build-preview').disabled=true;set('build-status',`Unavailable: ${e.message}. No installation, execution, or connection is inferred.`);}finally{busy=false;}}
 function showResult(r){const root=$('build-result');root.replaceChildren();const pre=document.createElement('pre');pre.textContent=JSON.stringify(r,null,2);root.append(pre);[...r.outputs,...r.logs.map((log,index)=>({path:'build-log-'+index+'.log',format:'file',sha256:log.sha256,bytes:log.bytes,chunks:1,logIndex:index}))].forEach((o,index)=>{const b=document.createElement('button');b.textContent='Download verified '+o.path;b.onclick=async()=>{const epoch=generation,abort=new AbortController();downloads.add(abort);b.disabled=true;try{const chunks=[];let size=0;for(let i=0;i<o.chunks;i++){if(epoch!==generation||abort.signal.aborted)throw Error('operator-session-changed');const response=await fetch(o.logIndex===undefined?'/api/builds/result-chunk':'/api/builds/result-log',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify(o.logIndex===undefined?{jobId:r.jobId,outputIndex:index,chunkIndex:i}:{jobId:r.jobId,logIndex:o.logIndex}),signal:AbortSignal.any([abort.signal,AbortSignal.timeout(12000)])});if(epoch!==generation)throw Error('operator-session-changed');if(!response.ok)throw Error('artifact-read-unavailable');const bytes=new Uint8Array(await response.arrayBuffer());if(epoch!==generation||abort.signal.aborted)throw Error('operator-session-changed');size+=bytes.length;if(size>o.bytes||size>128*1024*1024)throw Error('artifact-size-limit');chunks.push(bytes);}if(size!==o.bytes)throw Error('artifact-size-mismatch');const bytes=new Uint8Array(size);let offset=0;for(const chunk of chunks){bytes.set(chunk,offset);offset+=chunk.length;}const digest=[...new Uint8Array(await crypto.subtle.digest('SHA-256',bytes))].map(x=>x.toString(16).padStart(2,'0')).join('');if(epoch!==generation)throw Error('operator-session-changed');if(digest!==o.sha256)throw Error('artifact-integrity-mismatch');const url=URL.createObjectURL(new Blob([bytes],{type:'application/octet-stream'}));const a=document.createElement('a');a.href=url;a.download=o.path.split('/').pop()+(o.format==='tar'?'.tar':'');a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}catch(e){set('build-status',e.message);}finally{downloads.delete(abort);abort.abort();b.disabled=false;}};root.append(b);});}
 $('build-refresh').onclick=refresh;$('build-project').onchange=()=>fill('','');$('build-input').onchange=resetPreview;$('build-profile').onchange=resetPreview;
 $('build-preview').onclick=async()=>{const revision=placementRevision;try{const selection={profileHash:$('build-profile').value,inputHash:$('build-input').value};const r=await api('preview',selection);if(revision!==placementRevision||selection.profileHash!==$('build-profile').value||selection.inputHash!==$('build-input').value)return;preview=selection;list('build-placement',r.candidates,c=>`${c.workerId}: ${c.eligible?'eligible':'deferred'} · ${c.reasons.join(', ')}`);$('build-submit').disabled=!view?.actionsEnabled||!view.allowedProfiles.includes(selection.profileHash)||!r.candidates.some(c=>c.eligible);}catch(e){if(revision!==placementRevision)return;resetPreview();set('build-status',e.message);}};
 $('build-submit').onclick=async()=>{if(!view?.actionsEnabled||!preview)return;const selection={projectId:$('build-project').value,profileHash:$('build-profile').value,inputHash:$('build-input').value};if(selection.profileHash!==preview.profileHash||selection.inputHash!==preview.inputHash)return;pending??={...selection,repeat:$('build-repeat').checked,jobId:'build-'+crypto.randomUUID(),requestId:crypto.randomUUID()};if(pending.profileHash!==selection.profileHash||pending.inputHash!==selection.inputHash){set('build-status','Resolve the pending submission before changing selection.');return;}try{$('build-submit').disabled=true;const receipt=await api('submit',pending);await api('ack',{requestId:receipt.requestId,jobId:receipt.jobId});pending=null;$('build-repeat').checked=false;await refresh();}catch(e){set('build-status',`Submission uncertain or rejected: ${e.message}. Retry retains exact job and request IDs; keep this page open.`);$('build-submit').disabled=!view?.actionsEnabled||!preview;}};
})();
