--- foundry-push	2026-10-21 22:03:31
+++ foundry-push	2026-11-10 10:37:47
@@ -12,9 +12,18 @@
   *) [ "${FOUNDRY_SEED:-}" = "$REPO" ] || { echo "REFUSED: $REPO is a base repo; land changes through a gate task (fork <task>--<agent>). Seeding a new base: FOUNDRY_SEED=$REPO" >&2; exit 2; } ;;
 esac
 cd "$(git rev-parse --show-toplevel)"
-umask 077; T=$(mktemp); A=$(mktemp); trap 'rm -f "$T" "$A"' EXIT
-(cd ~/Developer/foundry-integration/source && npx wrangler artifacts repos issue-token "$REPO" --namespace foundry-staging --scope write --ttl 900 --json 2>/dev/null) \
-  | python3 -c 'import json,sys; d=json.load(sys.stdin); t=d.get("plaintext") or d.get("token") or ""; print(t.split("?")[0])' > "$T"
-[ -s "$T" ] || { echo "no token issued" >&2; exit 1; }
+umask 077; T=$(mktemp); A=$(mktemp); E=$(mktemp); trap 'rm -f "$T" "$A" "$E"' EXIT
+# wrangler can answer "Access denied [code: 10004]" with a blank stdout (2026-11-10, every one cleared by a retry).
+# Unretried, that was a JSONDecodeError here, which killed a landing's re-push and left a verifier run unjudged.
+for try in 1 2 3 4; do
+  (cd ~/Developer/foundry-integration/source && npx wrangler artifacts repos issue-token "$REPO" --namespace foundry-staging --scope write --ttl 900 --json 2>"$E") \
+    | python3 -c 'import json,sys
+try: d=json.load(sys.stdin)
+except ValueError: sys.exit(0)
+t=d.get("plaintext") or d.get("token") or ""; print(t.split("?")[0])' > "$T" || true
+  [ -s "$T" ] && break
+  sleep $((try*3))
+done
+[ -s "$T" ] || { echo "no token issued for $REPO: $(grep -m1 -E 'code: [0-9]+' "$E" | cut -c1-160)" >&2; exit 1; }
 printf '#!/bin/sh\ncase "$1" in Username*) echo x;; *) cat "%s";; esac\n' "$T" > "$A"; chmod 700 "$A"
 GIT_ASKPASS="$A" GIT_TERMINAL_PROMPT=0 git -c credential.helper= push "https://c1c0329d34dfd27ac727c8a4ff18611f.artifacts.cloudflare.net/git/foundry-staging/$REPO.git" "$@"
