{
  "name": "foundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle:runner": "esbuild tools/gate-runner.ts --bundle --platform=node --format=esm --outfile=tools/dist/gate-runner.mjs --log-level=warning",
    "demo:graphvc": "npm run bundle:runner && tsx tools/graphvc-demo.ts --root /tmp/foundry-graphvc",
    "smoke:lkg": "tsx tools/lkg-smoke.ts",
    "deploy:orchestrator": "npm run deploy -w @foundry/orchestrator",
    "deploy:gate": "npm run deploy -w @foundry/gate",
    "deploy:api": "npm run deploy -w @foundry/api",
    "proof:lkg": "tsx tools/lkg-path-proof.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}